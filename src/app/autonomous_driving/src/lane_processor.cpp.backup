namespace lane_processor {

// ============================================================
// 내부 헬퍼 구조체: 차선 후보 정보
// ============================================================

struct LaneCandidate {
    interface::PolyfitLane polynomial;  // 피팅된 다항식
    double confidence;                   // 신뢰도 (0~1)
    double fit_error;                    // 피팅 오차 (RMSE)
    std::size_t point_count;            // 사용된 포인트 수
    
    LaneCandidate() : confidence(0.0), fit_error(0.0), point_count(0) {}
};

// ############################################################
//
//                    PUBLIC 영역
//
// ############################################################

// ============================================================
// 생성자
// ============================================================

LaneProcessor::LaneProcessor() 
    : current_driveway_(-1)
    , driveway_confidence_(0.0)
    , total_processed_frames_(0)
{
    // 미감지 프레임 카운터 초기화
    missing_frame_counter_.fill(MISSING_LANE_HOLD_FRAMES);
    
    // 신뢰도 초기화
    lane_confidence_.fill(0.0);
    
    // 히스토리 버퍼 초기화
    for (auto& history : lane_history_buffer_) {
        history.clear();
    }
    
    // 자차 중앙선 초기화
    ego_center_lane_.frame_id = "vehicle";
    ego_center_lane_.id = "ego_lane";
}

/**
 * ID: 1
 * description: 메인 차선 처리 함수. 처음 5프레임은 y기준 클러스터링, 이후는 drivelane 기준 클러스터링.
 *              다항식 피팅, 시간 안정화, 자차 위치 추정, 미관측 차선 생성을 수행하여 4개 차선의 다항식을 반환한다.
 * input: input - 카메라에서 감지된 차선 포인트 (interface::Lane)
 *        vehicle_state - 현재 차량 위치 및 방향 (interface::VehicleState)
 * output: 4개 차선(lane1~lane4)의 다항식 정보 (interface::PolyfitLanes)
 */
interface::PolyfitLanes LaneProcessor::Process(
    const interface::Lane& input, 
    const interface::VehicleState& vehicle_state) 
{
    interface::PolyfitLanes output;
    output.frame_id = input.frame_id.empty() ? "vehicle" : input.frame_id;
    const std::string frame_id = output.frame_id;

    total_processed_frames_++;

    // 메모리 정리
    CleanupOutOfRangeMemory(vehicle_state);

    std::vector<interface::PolyfitLane> final_lanes;
    
    if (total_processed_frames_ <= 5) {
        // ========== 초기화 단계 (처음 5프레임) ==========
        // 1. y좌표 기준 클러스터링 (±y 분리)
        auto clusters = GroupPointsByYCoordinate(input.point);
        
        if (clusters.empty()) {
            driveway_confidence_ *= 0.7;
            return output;
        }
        
        // 2. 다항식 피팅
        std::vector<LaneCandidate> candidates;
        for (const auto& cluster : clusters) {
            interface::PolyfitLane poly;
            poly.frame_id = frame_id;
            poly.id = "observed";
            double rmse = 0.0;
            
            if (FitCubicPolynomial(cluster, poly, rmse)) {
                LaneCandidate cand;
                cand.polynomial = poly;
                cand.fit_error = rmse;
                cand.point_count = cluster.size();
                cand.confidence = CalculateFitConfidence(cand.point_count, rmse, poly, 0);
                candidates.push_back(cand);
            }
        }
        
        if (candidates.empty()) {
            driveway_confidence_ *= 0.7;
            return output;
        }
        
        // y@x=0 기준 정렬
        std::sort(candidates.begin(), candidates.end(),
            [&](const LaneCandidate& a, const LaneCandidate& b) {
                return EvaluatePolynomialAt(a.polynomial, 0.0) < EvaluatePolynomialAt(b.polynomial, 0.0);
            });
        
        // 3. lane2, lane3 생성 및 외분/내분으로 lane1, lane4, drivelane 생성
        final_lanes = ProcessInitializationPhase(candidates, frame_id);
        
        // 4. 메모리 초기 저장
        AddObservationsToMemory(clusters, final_lanes, vehicle_state);
        
    } else {
        // ========== 정상 처리 단계 (5프레임 이후) ==========
        // 1. drivelane 기준 클러스터링
        auto lane_clusters = GroupPointsByDrivelane(input.point);
        
        // 2. 메모리 + 새 관측 결합하여 피팅
        final_lanes = ProcessNormalPhase(lane_clusters, vehicle_state, frame_id);
        
        // 3. 메모리 업데이트
        AddObservationsToMemory(lane_clusters, final_lanes, vehicle_state);
    }

    // 최소 4개 차선 보장
    while (final_lanes.size() < 4) {
        interface::PolyfitLane dummy;
        dummy.id = "lane" + std::to_string(final_lanes.size() + 1);
        dummy.frame_id = frame_id;
        final_lanes.push_back(dummy);
    }
    if (final_lanes.size() > 4) {
        final_lanes.resize(4);
    }

    // 자차 위치 추정 및 drivelane 업데이트
    FindCurrentDriveway(final_lanes);
    
    // 미관측 차선 재생성
    RegenerateUnobservedLanes(final_lanes, frame_id);

    // 로깅
    LogProcessingStatus(final_lanes.size(), final_lanes.size());

    output.polyfitlanes = final_lanes;

    return output;
}

// 자차 중앙선 반환
interface::PolyfitLane LaneProcessor::GetEgoLane() const {
    return ego_center_lane_;
}

// 차선 메모리 포인트를 차량 좌표계로 변환하여 반환 (디버깅/시각화용)
std::vector<geometry_msgs::msg::Point> LaneProcessor::GetLane1MemoryInVehicleFrame(
    const interface::VehicleState& vehicle_state) const {
    return ConvertGlobalToVehicleFrame(lane_point_memory_[0], vehicle_state);
}

std::vector<geometry_msgs::msg::Point> LaneProcessor::GetLane2MemoryInVehicleFrame(
    const interface::VehicleState& vehicle_state) const {
    return ConvertGlobalToVehicleFrame(lane_point_memory_[1], vehicle_state);
}

std::vector<geometry_msgs::msg::Point> LaneProcessor::GetLane3MemoryInVehicleFrame(
    const interface::VehicleState& vehicle_state) const {
    return ConvertGlobalToVehicleFrame(lane_point_memory_[2], vehicle_state);
}

std::vector<geometry_msgs::msg::Point> LaneProcessor::GetLane4MemoryInVehicleFrame(
    const interface::VehicleState& vehicle_state) const {
    return ConvertGlobalToVehicleFrame(lane_point_memory_[3], vehicle_state);
}

/**
 * ID: 4
 * description: 차선 다항식을 RViz 시각화용 LINE_STRIP 마커로 변환한다.
 *              x 범위(MEMORY_X_MIN ~ MEMORY_X_MAX)에서 0.5m 간격으로 포인트를 생성한다.
 * input: lane - 차선 다항식 (interface::PolyfitLane)
 *        frame_id - 좌표계 ID (std::string)
 *        marker_id - 마커 고유 번호 (int)
 *        r, g, b - RGB 색상값 (0~1) (double)
 * output: RViz용 라인 마커 (visualization_msgs::msg::Marker)
 */
visualization_msgs::msg::Marker LaneProcessor::CreateVisualizationMarker(
    const interface::PolyfitLane& lane,
    const std::string& frame_id,
    int marker_id,
    double r, double g, double b) const
{
    visualization_msgs::msg::Marker marker;
    
    marker.header.frame_id = frame_id.empty() ? "vehicle" : frame_id;
    marker.header.stamp = rclcpp::Clock().now();
    marker.ns = "lane_processor";
    marker.id = marker_id;
    marker.type = visualization_msgs::msg::Marker::LINE_STRIP;
    marker.action = visualization_msgs::msg::Marker::ADD;
    
    marker.scale.x = 0.15;
    marker.color.r = static_cast<float>(r);
    marker.color.g = static_cast<float>(g);
    marker.color.b = static_cast<float>(b);
    marker.color.a = 0.8f;
    
    marker.lifetime = rclcpp::Duration::from_seconds(0.5);
    
    for (double x = MEMORY_X_MIN; x <= MEMORY_X_MAX; x += 0.5) {
        geometry_msgs::msg::Point p;
        p.x = x;
        p.y = EvaluatePolynomialAt(lane, x);
        p.z = 0.0;
        marker.points.push_back(p);
    }
    
    return marker;
}

// ============================================================
// 레거시 호환 함수들 (하위 호환성 유지)
// ============================================================

std::vector<geometry_msgs::msg::Point> LaneProcessor::getLane0PointsMemoryVehicleFrame(
    const interface::VehicleState& vehicle_state) const {
