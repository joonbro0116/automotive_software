// ============================================================
// 유틸리티 함수들
// ============================================================

/**
 * ID: 18
 * description: 3차 다항식의 특정 x좌표에서 y값을 계산한다. (y = a0 + a1*x + a2*x² + a3*x³)
 * input: lane - 차선 다항식 (interface::PolyfitLane)
 *        x_value - 계산할 x좌표 (double)
 * output: 해당 x좌표에서의 y값 (double)
 */
double LaneProcessor::EvaluatePolynomialAt(
    const interface::PolyfitLane& lane, 
    double x_value) const 
{
    // y = a0 + a1*x + a2*x^2 + a3*x^3
    double x2 = x_value * x_value;
    double x3 = x2 * x_value;
    return lane.a0 + lane.a1 * x_value + lane.a2 * x2 + lane.a3 * x3;
}

/**
 * ID: 17
 * description: 전역 좌표계의 포인트 목록을 차량 좌표계로 변환한다.
 *              회전 변환: x_veh = dx*cos(yaw) + dy*sin(yaw), y_veh = -dx*sin(yaw) + dy*cos(yaw)
 * input: global_points - 전역 좌표 포인트 목록 (std::vector<geometry_msgs::msg::Point>)
 *        vehicle_state - 현재 차량 상태 (interface::VehicleState)
 * output: 차량 좌표계 기준 포인트 목록 (std::vector<geometry_msgs::msg::Point>)
 */
std::vector<geometry_msgs::msg::Point> LaneProcessor::ConvertGlobalToVehicleFrame(
    const std::vector<geometry_msgs::msg::Point>& global_points,
    const interface::VehicleState& vehicle_state) const
{
    std::vector<geometry_msgs::msg::Point> result;
    result.reserve(global_points.size());
    
    double cos_yaw = std::cos(vehicle_state.yaw);
    double sin_yaw = std::sin(vehicle_state.yaw);
    
    for (const auto& p : global_points) {
        double dx = p.x - vehicle_state.x;
        double dy = p.y - vehicle_state.y;
        
        geometry_msgs::msg::Point veh_pt;
        veh_pt.x = dx * cos_yaw + dy * sin_yaw;
        veh_pt.y = -dx * sin_yaw + dy * cos_yaw;
        veh_pt.z = 0.0;
        result.push_back(veh_pt);
    }
    
    return result;
}

/**
 * ID: 19
 * description: 처리 상태를 1초 간격으로 로깅한다. 현재 driveway, 클러스터 수, 차선 수,
 *              각 차선 메모리 크기를 출력한다.
 * input: cluster_count - 클러스터 수 (size_t)
 *        lane_count - 차선 수 (size_t)
 * output: 없음 (로그 출력)
 */
void LaneProcessor::LogProcessingStatus(size_t cluster_count, size_t lane_count)
{
    static auto last_log = std::chrono::steady_clock::now();
    auto now = std::chrono::steady_clock::now();
    auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - last_log);
    
    if (elapsed.count() >= 1000) {
        last_log = now;
        
        std::string driveway_name;
        if (current_driveway_ == 1) driveway_name = "drivelane1 (lane1-lane2)";
        else if (current_driveway_ == 2) driveway_name = "drivelane2 (lane2-lane3)";
        else if (current_driveway_ == 3) driveway_name = "drivelane3 (lane3-lane4)";
        else driveway_name = "Unknown";
        
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "=== LANE PROCESSOR (frame %d) ===", total_processed_frames_);
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "Driveway: %s (conf: %.2f)", driveway_name.c_str(), driveway_confidence_);
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "Clusters: %zu, Lanes: %zu", cluster_count, lane_count);
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "Memory: lane1=%zu, lane2=%zu, lane3=%zu, lane4=%zu",
            lane_point_memory_[0].size(), lane_point_memory_[1].size(),
            lane_point_memory_[2].size(), lane_point_memory_[3].size());
    }
}

// ============================================================
// 클러스터링 함수들
// ============================================================

/**
 * ID: 2
 * description: [초기화 전용] 포인트를 y좌표 기준으로 정렬 후, 인접 포인트 간 y 간격이 CLUSTER_Y_GAP_THRESHOLD(2.5m)
 *              이상이면 새 클러스터로 분리하여 차선별로 그룹화한다. 처음 5프레임에만 사용.
 * input: input_points - 입력 포인트 목록 (std::vector<Point2D>)
 * output: 클러스터 목록, 각 클러스터는 하나의 차선에 해당 (std::vector<std::vector<Point2D>>)
 */
std::vector<std::vector<LaneProcessor::Point2D>> LaneProcessor::GroupPointsByYCoordinate(
    const std::vector<Point2D>& input_points) const 
{
    std::vector<std::vector<Point2D>> clusters;
    
    if (input_points.empty()) {
        return clusters;
    }

    // 1. y좌표 기준 정렬
    std::vector<Point2D> sorted_points = input_points;
    std::sort(sorted_points.begin(), sorted_points.end(),
        [](const Point2D& a, const Point2D& b) { return a.y < b.y; });

    // 2. 간격 기반 클러스터링
    std::vector<Point2D> current_cluster;
    current_cluster.reserve(sorted_points.size());
    
    for (size_t i = 0; i < sorted_points.size(); ++i) {
        const Point2D& pt = sorted_points[i];
        
        if (current_cluster.empty()) {
            current_cluster.push_back(pt);
            continue;
        }
        
        // y 간격 확인
        double y_gap = pt.y - current_cluster.back().y;
        
        if (y_gap <= CLUSTER_Y_GAP_THRESHOLD) {
            current_cluster.push_back(pt);
        } else {
            // 현재 클러스터 저장 후 새 클러스터 시작
            if (IsClusterValid(current_cluster)) {
                clusters.push_back(current_cluster);
            }
            current_cluster.clear();
            current_cluster.push_back(pt);
        }
    }

    // 3. 마지막 클러스터 처리
    if (IsClusterValid(current_cluster)) {
        clusters.push_back(current_cluster);
    }

    // 4. y 평균 기준으로 클러스터 정렬
    std::sort(clusters.begin(), clusters.end(),
        [](const std::vector<Point2D>& a, const std::vector<Point2D>& b) {
            double sum_a = 0.0, sum_b = 0.0;
            for (const auto& p : a) sum_a += p.y;
            for (const auto& p : b) sum_b += p.y;
            return (sum_a / a.size()) < (sum_b / b.size());
        });

    return clusters;
}

/**
 * ID: 20
 * description: [정상 처리 전용] drivelane 기준으로 포인트를 클러스터링한다. 각 포인트의 x값을 drivelane에 넣어
 *              예측 y값을 계산하고, 실제 y값과 비교하여 어느 차선에 속하는지 판단한다. 5프레임 이후 사용.
 * input: input_points - 입력 포인트 목록 (std::vector<Point2D>)
 * output: 4개 차선별로 분류된 포인트 배열 (std::array<std::vector<Point2D>, 4>)
 */
std::array<std::vector<LaneProcessor::Point2D>, 4> LaneProcessor::GroupPointsByDrivelane(
    const std::vector<Point2D>& input_points) const 
{
    std::array<std::vector<Point2D>, 4> lane_clusters;
    
    if (input_points.empty()) {
        return lane_clusters;
    }
    
    // drivelane이 없으면 y 기준 폴백
    if (lane_history_buffer_[1].empty() || lane_history_buffer_[2].empty()) {
        // 간단히 y값으로 4등분
        std::vector<Point2D> sorted = input_points;
        std::sort(sorted.begin(), sorted.end(),
            [](const Point2D& a, const Point2D& b) { return a.y < b.y; });
        
        for (const auto& pt : sorted) {
            if (pt.y < -4.0) lane_clusters[0].push_back(pt);
            else if (pt.y < 0.0) lane_clusters[1].push_back(pt);
            else if (pt.y < 4.0) lane_clusters[2].push_back(pt);
            else lane_clusters[3].push_back(pt);
        }
        return lane_clusters;
    }
    
    // drivelane1 (lane1-lane2 사이 중앙선)
    interface::PolyfitLane drivelane1 = InterpolateBetweenLanes(
        lane_history_buffer_[0].back(), lane_history_buffer_[1].back(), 0.5, "vehicle");
    
    // drivelane2 (lane2-lane3 사이 중앙선)
    interface::PolyfitLane drivelane2 = InterpolateBetweenLanes(
        lane_history_buffer_[1].back(), lane_history_buffer_[2].back(), 0.5, "vehicle");
    
    // drivelane3 (lane3-lane4 사이 중앙선)
    interface::PolyfitLane drivelane3 = InterpolateBetweenLanes(
        lane_history_buffer_[2].back(), lane_history_buffer_[3].back(), 0.5, "vehicle");
    
    // 각 포인트를 drivelane 기준으로 분류
    for (const auto& pt : input_points) {
        double x = pt.x;
        double y = pt.y;
        
        double y_drivelane1 = EvaluatePolynomialAt(drivelane1, x);
        double y_drivelane2 = EvaluatePolynomialAt(drivelane2, x);
        double y_drivelane3 = EvaluatePolynomialAt(drivelane3, x);
        
        // drivelane 기준으로 차선 판단
        if (y < y_drivelane1) {
            // drivelane1보다 왼쪽 -> lane1
            lane_clusters[0].push_back(pt);
        } else if (y < y_drivelane2) {
            // drivelane1과 drivelane2 사이 -> lane2
            lane_clusters[1].push_back(pt);
        } else if (y < y_drivelane3) {
            // drivelane2와 drivelane3 사이 -> lane3
            lane_clusters[2].push_back(pt);
        } else {
            // drivelane3보다 오른쪽 -> lane4
            lane_clusters[3].push_back(pt);
        }
    }
    
    return lane_clusters;
}

/**
 * ID: 21
 * description: 클러스터 유효성 검사. 최소 포인트 수(5개)와 최소 x범위(4m)를 충족하는지 확인한다.
 * input: cluster - 검사할 클러스터 (std::vector<Point2D>)
 * output: 유효 여부 (bool)
 */
bool LaneProcessor::IsClusterValid(const std::vector<Point2D>& cluster) const 
{
    if (cluster.size() < MIN_POINTS_FOR_VALID_CLUSTER) {
        return false;
    }
    
    // x 범위 계산
    double x_min = cluster[0].x;
    double x_max = cluster[0].x;
    for (const auto& pt : cluster) {
        if (pt.x < x_min) x_min = pt.x;
        if (pt.x > x_max) x_max = pt.x;
    }
    
    return (x_max - x_min) >= MIN_X_RANGE_FOR_VALID_CLUSTER;
}

/**
 * ID: 5
 * description: QR 분해 기반 최소자승법으로 포인트에 3차 다항식(y = a0 + a1*x + a2*x² + a3*x³)을 피팅한다.
 *              RMSE가 MAX_ACCEPTABLE_FIT_ERROR(0.8) 초과 또는 계수가 20 초과 시 실패 처리한다.
 * input: points - 피팅할 포인트들 (std::vector<Point2D>)
 * output: out_poly - 피팅된 다항식 계수 (interface::PolyfitLane&)
 *         out_error - 피팅 오차 RMSE (double&)
 *         반환값 - 피팅 성공 여부 (bool)
 */
bool LaneProcessor::FitCubicPolynomial(
    const std::vector<Point2D>& points, 
    interface::PolyfitLane& out_poly, 
    double& out_error) const 
{
    if (points.size() < 4) {
        return false;
    }

    const int n = static_cast<int>(points.size());

    // 행렬 구성: A * coeffs = y
    Eigen::MatrixXd A(n, 4);
    Eigen::VectorXd y(n);

    double x_min = points[0].x;
    double x_max = points[0].x;

    for (int i = 0; i < n; ++i) {
        double x = points[i].x;
        double x2 = x * x;
        double x3 = x2 * x;

        A(i, 0) = 1.0;
        A(i, 1) = x;
        A(i, 2) = x2;
        A(i, 3) = x3;
        y(i) = points[i].y;

        if (x < x_min) x_min = x;
        if (x > x_max) x_max = x;
    }

    // QR 분해로 최소자승 해 계산
    Eigen::Vector4d coeffs = A.colPivHouseholderQr().solve(y);
    
    if (!coeffs.allFinite()) {
        return false;
    }

    // RMSE 계산
    double sum_err_sq = 0.0;
    for (int i = 0; i < n; ++i) {
        double x = points[i].x;
        double pred = coeffs(0) + coeffs(1)*x + coeffs(2)*x*x + coeffs(3)*x*x*x;
        double err = pred - points[i].y;
        sum_err_sq += err * err;
    }
    double rmse = std::sqrt(sum_err_sq / n);

    // 품질 검사
    if (rmse > MAX_ACCEPTABLE_FIT_ERROR || coeffs.cwiseAbs().maxCoeff() > 20.0) {
        return false;
    }

    out_poly.a0 = coeffs(0);
    out_poly.a1 = coeffs(1);
    out_poly.a2 = coeffs(2);
    out_poly.a3 = coeffs(3);
    out_poly.x_start = x_min;
    out_poly.x_end = x_max;
    out_error = rmse;

    return true;
}

/**
 * ID: 6
 * description: 피팅 결과의 신뢰도를 계산한다. 포인트 수 점수(50%), 오차 점수(30%), 안정성 점수(20%)의
 *              가중 평균으로 0~1 범위의 신뢰도를 반환한다.
 * input: point_count - 사용된 포인트 수 (std::size_t)
 *        fit_error - 피팅 오차 RMSE (double)
 *        poly - 피팅된 다항식 (interface::PolyfitLane)
 *        lane_idx - 차선 인덱스 0~3 (std::size_t)
 * output: 신뢰도 0.0~1.0 (double)
 */
double LaneProcessor::CalculateFitConfidence(
    std::size_t point_count, 
    double fit_error, 
    const interface::PolyfitLane& poly,
    std::size_t lane_idx) const 
{
    // 포인트 수 점수
    double pt_score = std::min(1.0, point_count / (MIN_POINTS_FOR_VALID_CLUSTER + 2.0));
    
    // 오차 점수
    double err_score = std::max(0.0, 1.0 - fit_error / MAX_ACCEPTABLE_FIT_ERROR);
    
    // 안정성 점수
    double stab_score = CalculateStabilityScore(lane_idx, poly);

    // 가중 평균
    double conf = 0.5 * pt_score + 0.3 * err_score + 0.2 * stab_score;
    return std::max(0.0, std::min(1.0, conf));
}

/**
 * ID: 7
 * description: 이전 프레임 대비 다항식 계수 변화량을 기반으로 안정성 점수를 계산한다.
 *              변화량이 작을수록 높은 점수(최대 1.0)를 반환한다.
 * input: lane_idx - 차선 인덱스 (std::size_t)
 *        poly - 현재 프레임 다항식 (interface::PolyfitLane)
 * output: 안정성 점수 0.0~1.0 (double)
 */
double LaneProcessor::CalculateStabilityScore(
    std::size_t lane_idx, 
    const interface::PolyfitLane& poly) const 
{
    if (lane_idx >= MAX_LANE_COUNT || lane_history_buffer_[lane_idx].empty()) {
        return 1.0;
    }

    const auto& prev = lane_history_buffer_[lane_idx].back();
    double diff = std::fabs(poly.a0 - prev.a0) 
                + 0.5 * std::fabs(poly.a1 - prev.a1)
                + 0.2 * std::fabs(poly.a2 - prev.a2)
                + 0.1 * std::fabs(poly.a3 - prev.a3);

    return std::max(0.0, std::min(1.0, 1.0 / (1.0 + diff)));
}

/**
 * ID: 10
 * description: 시간 안정화 적용. 이전 프레임과 현재 프레임의 다항식 계수를 신뢰도 기반 가중 평균하여
 *              프레임 간 떨림을 감소시킨다. 히스토리 버퍼도 업데이트한다.
 * input: lane_idx - 차선 인덱스 (std::size_t)
 *        current - 현재 프레임 다항식 (interface::PolyfitLane)
 *        confidence - 신뢰도 (double)
 *        keep_missing - 미감지 상태 유지 여부 (bool)
 * output: 안정화된 다항식 (interface::PolyfitLane)
 */
interface::PolyfitLane LaneProcessor::ApplyTemporalSmoothing(
    std::size_t lane_idx,
    const interface::PolyfitLane& current,
    double confidence,
    bool keep_missing) 
{
    confidence = std::max(0.0, std::min(1.0, confidence));
    
    // 가중치 계산
    double new_weight = SMOOTHING_MIN_WEIGHT + SMOOTHING_NEW_DATA_WEIGHT * confidence;
    new_weight = std::min(1.0, new_weight);
    double old_weight = 1.0 - new_weight;

    interface::PolyfitLane smoothed = current;
    
    if (!lane_history_buffer_[lane_idx].empty()) {
        const auto& prev = lane_history_buffer_[lane_idx].back();
        smoothed.a0 = new_weight * current.a0 + old_weight * prev.a0;
        smoothed.a1 = new_weight * current.a1 + old_weight * prev.a1;
        smoothed.a2 = new_weight * current.a2 + old_weight * prev.a2;
        smoothed.a3 = new_weight * current.a3 + old_weight * prev.a3;
        smoothed.x_start = current.x_start;
        smoothed.x_end = current.x_end;
    }

    // 히스토리 업데이트
    if (lane_history_buffer_[lane_idx].size() >= HISTORY_BUFFER_SIZE) {
        lane_history_buffer_[lane_idx].pop_front();
    }
    lane_history_buffer_[lane_idx].push_back(smoothed);

    if (!keep_missing) {
        missing_frame_counter_[lane_idx] = 0;
    }
    lane_confidence_[lane_idx] = confidence;
    
    smoothed.frame_id = "vehicle";
    smoothed.id = current.id;
    return smoothed;
}

/**
 * ID: 12
 * description: 미감지 차선의 신뢰도를 0.7배로 감쇠시키고, 미감지 프레임 카운터를 증가시킨다.
 * input: lane_idx - 차선 인덱스 (std::size_t)
 * output: 없음 (내부 상태 변경)
 */
void LaneProcessor::ApplyMissingLaneDecay(std::size_t lane_idx) 
{
    if (lane_idx >= MAX_LANE_COUNT) return;
    
    missing_frame_counter_[lane_idx]++;
    if (missing_frame_counter_[lane_idx] > MISSING_LANE_HOLD_FRAMES + 2) {
        missing_frame_counter_[lane_idx] = MISSING_LANE_HOLD_FRAMES + 2;
    }
    lane_confidence_[lane_idx] *= 0.7;
}

/**
 * ID: 13
 * description: 자차(y=0)가 어느 두 차선 사이에 있는지 판단한다.
 *              반환값 1: lane1-lane2 사이, 2: lane2-lane3 사이, 3: lane3-lane4 사이.
 *              히스테리시스를 적용하여 급격한 차로 변경 판단을 방지한다.
 * input: lanes - 4개 차선 다항식 목록 (std::vector<interface::PolyfitLane>)
 * output: 자차 위치 1, 2, 3 중 하나 (int)
 */
int LaneProcessor::FindCurrentDriveway(const std::vector<interface::PolyfitLane>& lanes) 
{
    if (lanes.empty()) {
        driveway_confidence_ *= 0.7;
        return current_driveway_;
    }

    // 자차(y=0)가 어느 두 차선 사이인지 찾기
    int detected = -1;
    
    for (size_t i = 0; i + 1 < lanes.size(); ++i) {
        double y_left = EvaluatePolynomialAt(lanes[i], 0.0);
        double y_right = EvaluatePolynomialAt(lanes[i + 1], 0.0);
        
        bool between = (y_left < y_right) 
            ? (y_left <= 0.0 && y_right >= 0.0)
            : (y_right <= 0.0 && y_left >= 0.0);
        
        if (between) {
            detected = static_cast<int>(i + 1);
            break;
        }
    }

    // 정확한 매칭 실패시 가장 가까운 쌍 찾기
    if (detected < 0) {
        double best_dist = 1e9;
        for (size_t i = 0; i + 1 < lanes.size(); ++i) {
            double y_left = EvaluatePolynomialAt(lanes[i], 0.0);
            double y_right = EvaluatePolynomialAt(lanes[i + 1], 0.0);
            double mid = (y_left + y_right) / 2.0;
            double dist = std::fabs(mid);
            
            if (dist < best_dist) {
                best_dist = dist;
                detected = static_cast<int>(i + 1);
            }
        }
    }

    // 범위 제한
    if (detected < 1) detected = 1;
    if (detected > 3) detected = 3;

    // 신뢰도 계산
    double bound_conf = 0.4;
    if (detected > 0 && detected < static_cast<int>(MAX_LANE_COUNT)) {
        double left_c = lane_confidence_[detected - 1];
        double right_c = lane_confidence_[detected];
        bound_conf = std::min(left_c, right_c);
    }

    double blend_conf = 0.6 * bound_conf + 0.4 * driveway_confidence_;
    blend_conf += (detected == current_driveway_) ? 0.1 : -0.1;
    blend_conf = std::max(0.0, std::min(1.0, blend_conf));

    // 히스테리시스
    if (detected != current_driveway_ && blend_conf < 0.35) {
        detected = current_driveway_;
    } else {
        current_driveway_ = detected;
    }
    driveway_confidence_ = blend_conf;

    // Ego lane 업데이트
    if (lanes.size() >= 2 && detected >= 1 && detected < static_cast<int>(lanes.size())) {
        auto center = InterpolateBetweenLanes(lanes[detected-1], lanes[detected], 0.5, lanes[detected].frame_id);
        
        ego_center_lane_.a0 = 0.6 * center.a0 + 0.4 * ego_center_lane_.a0;
        ego_center_lane_.a1 = 0.6 * center.a1 + 0.4 * ego_center_lane_.a1;
        ego_center_lane_.a2 = 0.6 * center.a2 + 0.4 * ego_center_lane_.a2;
        ego_center_lane_.a3 = 0.6 * center.a3 + 0.4 * ego_center_lane_.a3;
        ego_center_lane_.x_start = center.x_start;
        ego_center_lane_.x_end = center.x_end;
        ego_center_lane_.frame_id = lanes[detected].frame_id;
    }

    return current_driveway_;
}

/**
 * ID: 9
 * description: 두 차선 사이를 선형 보간/외삽하여 새 차선을 생성한다.
 *              ratio=0: left와 동일, ratio=1: right와 동일, ratio<0 또는 >1: 외삽
 * input: left - 왼쪽(y가 작은) 차선 (interface::PolyfitLane)
 *        right - 오른쪽(y가 큰) 차선 (interface::PolyfitLane)
 *        ratio - 보간 비율 (double)
 *        frame_id - 좌표계 ID (std::string)
 * output: 생성된 차선 다항식 (interface::PolyfitLane)
 */
interface::PolyfitLane LaneProcessor::InterpolateBetweenLanes(
    const interface::PolyfitLane& left,
    const interface::PolyfitLane& right,
    double ratio,
    const std::string& frame_id) const 
{
    // ratio = 0: left와 동일, ratio = 1: right와 동일
    // ratio < 0 또는 > 1: 외삽
    
    double w_left = 1.0 - ratio;
    double w_right = ratio;
    
    interface::PolyfitLane result;
    result.frame_id = frame_id;
    result.id = "generated_lane";
    result.a0 = w_left * left.a0 + w_right * right.a0;
    result.a1 = w_left * left.a1 + w_right * right.a1;
    result.a2 = w_left * left.a2 + w_right * right.a2;
    result.a3 = w_left * left.a3 + w_right * right.a3;
    result.x_start = 0.5 * (left.x_start + right.x_start);
    result.x_end = 0.5 * (left.x_end + right.x_end);
    
    return result;
}

/**
 * ID: 14
 * description: 현재 자차 위치(driveway)를 기반으로 미관측 차선을 보간/외삽으로 재생성한다.
 *              driveway=1: lane3,4 재생성, driveway=2: lane1,4 재생성, driveway=3: lane1,2 재생성
 * input: lanes - 4개 차선 다항식 목록 (참조로 수정됨) (std::vector<interface::PolyfitLane>&)
 *        frame_id - 좌표계 ID (std::string)
 * output: 없음 (lanes 벡터 직접 수정)
 */
void LaneProcessor::RegenerateUnobservedLanes(
    std::vector<interface::PolyfitLane>& lanes,
    const std::string& frame_id)
{
    if (lanes.size() < 4) return;
    
    if (current_driveway_ == 1) {
        // lane1, lane2 관측 -> lane3, lane4 재생성
        lanes[2] = InterpolateBetweenLanes(lanes[0], lanes[1], 2.0, frame_id);
        lanes[2].id = "lane3";
        lanes[3] = InterpolateBetweenLanes(lanes[0], lanes[1], 3.0, frame_id);
        lanes[3].id = "lane4";
    } else if (current_driveway_ == 2) {
        // lane2, lane3 관측 -> lane1, lane4 재생성
        lanes[0] = InterpolateBetweenLanes(lanes[1], lanes[2], -1.0, frame_id);
        lanes[0].id = "lane1";
        lanes[3] = InterpolateBetweenLanes(lanes[1], lanes[2], 2.0, frame_id);
        lanes[3].id = "lane4";
    } else if (current_driveway_ == 3) {
        // lane3, lane4 관측 -> lane1, lane2 재생성
        lanes[0] = InterpolateBetweenLanes(lanes[2], lanes[3], -2.0, frame_id);
        lanes[0].id = "lane1";
        lanes[1] = InterpolateBetweenLanes(lanes[2], lanes[3], -1.0, frame_id);
        lanes[1].id = "lane2";
    }
}

/**
 * ID: 8
 * description: 초기화 단계(처음 5프레임) 처리. 관측된 차선 후보들의 위치를 기반으로
 *              자차가 어느 차로에 있는지 추정하고, 4개 차선을 초기 할당한다.
 * input: candidates - 차선 후보 목록 (std::vector<LaneCandidate>)
 *        frame_id - 좌표계 ID (std::string)
 * output: 4개 차선 다항식 목록 (std::vector<interface::PolyfitLane>)
 */
std::vector<interface::PolyfitLane> LaneProcessor::ProcessInitializationPhase(
    const std::vector<LaneCandidate>& candidates,
    const std::string& frame_id)
{
    std::vector<interface::PolyfitLane> result;
    
    if (candidates.size() >= 2) {
        // 2개 이상: 자차 위치 기반 할당
        const auto& left = candidates[0].polynomial;
        const auto& right = candidates[1].polynomial;
        
        double center_y = (EvaluatePolynomialAt(left, 0.0) + EvaluatePolynomialAt(right, 0.0)) / 2.0;
        
        std::array<interface::PolyfitLane, 4> lanes;
        
        if (center_y < -2.0) {
            // 왼쪽 주행: lane1, lane2 관측
            lanes[0] = left; lanes[0].id = "lane1";
            lanes[1] = right; lanes[1].id = "lane2";
            lanes[2] = InterpolateBetweenLanes(left, right, 2.0, frame_id); lanes[2].id = "lane3";
            lanes[3] = InterpolateBetweenLanes(left, right, 3.0, frame_id); lanes[3].id = "lane4";
        } else if (center_y > 2.0) {
            // 오른쪽 주행: lane3, lane4 관측
            lanes[0] = InterpolateBetweenLanes(left, right, -2.0, frame_id); lanes[0].id = "lane1";
            lanes[1] = InterpolateBetweenLanes(left, right, -1.0, frame_id); lanes[1].id = "lane2";
            lanes[2] = left; lanes[2].id = "lane3";
            lanes[3] = right; lanes[3].id = "lane4";
        } else {
            // 중앙 주행: lane2, lane3 관측
            lanes[0] = InterpolateBetweenLanes(left, right, -1.0, frame_id); lanes[0].id = "lane1";
            lanes[1] = left; lanes[1].id = "lane2";
            lanes[2] = right; lanes[2].id = "lane3";
            lanes[3] = InterpolateBetweenLanes(left, right, 2.0, frame_id); lanes[3].id = "lane4";
        }
        
        for (size_t i = 0; i < 4; ++i) {
            lanes[i].frame_id = frame_id;
            result.push_back(ApplyTemporalSmoothing(i, lanes[i], 0.95, false));
        }
    } else if (candidates.size() == 1) {
        // 1개만: lane2로 가정
        const auto& obs = candidates[0].polynomial;
        
        interface::PolyfitLane lane1 = InterpolateBetweenLanes(obs, obs, -1.0, frame_id);
        lane1.id = "lane1";
        interface::PolyfitLane lane2 = obs;
        lane2.id = "lane2"; lane2.frame_id = frame_id;
        interface::PolyfitLane lane3 = InterpolateBetweenLanes(obs, obs, 0.5, frame_id);
        lane3.id = "lane3";
        interface::PolyfitLane lane4 = InterpolateBetweenLanes(obs, obs, 2.0, frame_id);
        lane4.id = "lane4";
        
        result.push_back(ApplyTemporalSmoothing(0, lane1, 0.85, false));
        result.push_back(ApplyTemporalSmoothing(1, lane2, 0.95, false));
        result.push_back(ApplyTemporalSmoothing(2, lane3, 0.90, false));
        result.push_back(ApplyTemporalSmoothing(3, lane4, 0.85, false));
    }
    
    return result;
}

/**
 * ID: 11
 * description: 정상 처리 단계(5프레임 이후). drivelane 기준으로 분류된 포인트와 메모리 누적 포인트를 결합하여
 *              각 차선을 피팅하고, 시간 안정화를 적용한다.
 * input: lane_clusters - 4개 차선별로 분류된 포인트 배열 (std::array<std::vector<Point2D>, 4>)
 *        vehicle_state - 차량 상태 (interface::VehicleState)
 *        frame_id - 좌표계 ID (std::string)
 * output: 4개 차선 다항식 목록 (std::vector<interface::PolyfitLane>)
 */
std::vector<interface::PolyfitLane> LaneProcessor::ProcessNormalPhase(
    const std::array<std::vector<Point2D>, 4>& lane_clusters,
    const interface::VehicleState& vehicle_state,
    const std::string& frame_id)
{
    std::vector<interface::PolyfitLane> result;
    
    double cos_yaw = std::cos(vehicle_state.yaw);
    double sin_yaw = std::sin(vehicle_state.yaw);
    
    // 각 차선별로 새 관측 데이터 여부 확인
    std::array<bool, 4> has_new_data;
    for (size_t i = 0; i < 4; ++i) {
        has_new_data[i] = !lane_clusters[i].empty();
    }
    
    // 각 차선 피팅
    std::array<bool, 4> lane_valid;
    lane_valid.fill(false);
    
    for (size_t i = 0; i < 4; ++i) {
        std::vector<Point2D> combined;
        
        // 메모리 포인트 변환 및 추가
        if (has_memory[i]) {
            for (const auto& p : lane_point_memory_[i]) {
                double dx = p.x - vehicle_state.x;
                double dy = p.y - vehicle_state.y;
                Point2D pt;
                pt.x = dx * cos_yaw + dy * sin_yaw;
                pt.y = -dx * sin_yaw + dy * cos_yaw;
                combined.push_back(pt);
            }
            if (combined.size() > 100) {
                combined.erase(combined.begin(), combined.end() - 100);
            }
        }
        
        // 새 클러스터 추가
        if (has_new_data[i]) {
            combined.insert(combined.end(), lane_clusters[i].begin(), lane_clusters[i].end());
        }
        
        // 피팅
        if (combined.size() >= MIN_POINTS_FOR_VALID_CLUSTER) {
            interface::PolyfitLane poly;
            poly.frame_id = frame_id;
            poly.id = "lane" + std::to_string(i + 1);
            double rmse = 0.0;
            
            if (FitCubicPolynomial(combined, poly, rmse)) {
                double conf = CalculateFitConfidence(combined.size(), rmse, poly, i);
                if (has_new_data[i]) conf = std::min(1.0, conf + 0.1);
                result.push_back(ApplyTemporalSmoothing(i, poly, conf, false));
                lane_valid[i] = true;
            }
        }
        
        // 버퍼에서 복원
        if (!lane_valid[i] && !lane_history_buffer_[i].empty()) {
            auto buffered = lane_history_buffer_[i].back();
            buffered.id = "lane" + std::to_string(i + 1);
            buffered.frame_id = frame_id;
            ApplyMissingLaneDecay(i);
            result.push_back(buffered);
            lane_valid[i] = true;
        }
    }
    
    // ID 순 정렬
    std::sort(result.begin(), result.end(),
        [](const interface::PolyfitLane& a, const interface::PolyfitLane& b) {
            return a.id < b.id;
        });
    
    return result;
}

/**
 * ID: 16
 * description: 메모리에서 범위 밖 포인트를 정리한다. 차량 좌표계 기준 x가 MEMORY_X_MIN(-30m) ~
 *              MEMORY_X_MAX(20m) 범위 밖인 포인트를 삭제하고, 최대 200개로 크기를 제한한다.
 * input: vehicle_state - 현재 차량 상태 (interface::VehicleState)
 * output: 없음 (내부 메모리 정리)
 */
void LaneProcessor::CleanupOutOfRangeMemory(const interface::VehicleState& vehicle_state)
{
    double cos_yaw = std::cos(vehicle_state.yaw);
    double sin_yaw = std::sin(vehicle_state.yaw);
    
    for (auto& mem : lane_point_memory_) {
        // 범위 밖 포인트 제거
        mem.erase(
            std::remove_if(mem.begin(), mem.end(),
                [&](const geometry_msgs::msg::Point& p) {
                    double dx = p.x - vehicle_state.x;
                    double dy = p.y - vehicle_state.y;
                    double x_veh = dx * cos_yaw + dy * sin_yaw;
                    return (x_veh < MEMORY_X_MIN || x_veh > MEMORY_X_MAX);
                }),
            mem.end());
        
        // 크기 제한
        if (mem.size() > 200) {
            mem.erase(mem.begin(), mem.begin() + (mem.size() - 200));
        }
    }
}

/**
 * ID: 15
 * description: 새로 관측된 클러스터 포인트를 해당 차선 메모리에 추가한다. 차량 좌표를 전역 좌표로
 *              변환하여 저장하며, 다운샘플링(0.1m 이내 중복 제거)을 적용한다.
 * input: lane_clusters - 4개 차선별로 분류된 포인트 (std::array<std::vector<Point2D>, 4> 또는 std::vector<std::vector<Point2D>>)
 *        lanes - 현재 차선 다항식 목록 (std::vector<interface::PolyfitLane>)
 *        vehicle_state - 현재 차량 상태 (interface::VehicleState)
 * output: 없음 (내부 메모리 갱신)
 */
void LaneProcessor::AddObservationsToMemory(
    const std::vector<std::vector<Point2D>>& lane_clusters,
    const std::vector<interface::PolyfitLane>& lanes,
    const interface::VehicleState& vehicle_state)
{
    if (lane_clusters.empty() || lanes.empty()) return;

    double cos_yaw = std::cos(vehicle_state.yaw);
    double sin_yaw = std::sin(vehicle_state.yaw);

    // 초기화 단계: 클러스터를 차선에 매칭
    if (total_processed_frames_ <= 5) {
        // 차선별 y@x=0 계산
        std::array<double, 4> lane_y0;
        std::array<bool, 4> lane_exists;
        lane_y0.fill(0.0);
        lane_exists.fill(false);
        
        for (const auto& lane : lanes) {
            int idx = -1;
            if (lane.id == "lane1") idx = 0;
            else if (lane.id == "lane2") idx = 1;
            else if (lane.id == "lane3") idx = 2;
            else if (lane.id == "lane4") idx = 3;
            
            if (idx >= 0 && idx < 4) {
                lane_y0[idx] = EvaluatePolynomialAt(lane, 0.0);
                lane_exists[idx] = true;
            }
        }

        std::array<bool, 4> lane_assigned;
        lane_assigned.fill(false);

        for (const auto& cluster : lane_clusters) {
            if (cluster.empty()) continue;

            double cluster_y = 0.0;
            for (const auto& p : cluster) cluster_y += p.y;
            cluster_y /= cluster.size();

            int best_lane = -1;
            double best_diff = 3.0;
            
            for (size_t i = 0; i < 4; ++i) {
                if (!lane_exists[i] || lane_assigned[i]) continue;
                double diff = std::fabs(lane_y0[i] - cluster_y);
                if (diff < best_diff) {
                    best_diff = diff;
                    best_lane = static_cast<int>(i);
                }
            }

            if (best_lane < 0) continue;
            lane_assigned[best_lane] = true;

            auto& mem = lane_point_memory_[best_lane];
            for (const auto& p : cluster) {
                double x_global = vehicle_state.x + p.x * cos_yaw - p.y * sin_yaw;
                double y_global = vehicle_state.y + p.x * sin_yaw + p.y * cos_yaw;
                
                // 다운샘플링: 기존 메모리에 가까운 점이 있으면 추가하지 않음
                bool too_close = false;
                const double resolution_sq = MEMORY_DOWNSAMPLE_RESOLUTION * MEMORY_DOWNSAMPLE_RESOLUTION;
                for (const auto& existing : mem) {
                    double dx = x_global - existing.x;
                    double dy = y_global - existing.y;
                    if (dx * dx + dy * dy < resolution_sq) {
                        too_close = true;
                        break;
                    }
                }
                
                if (!too_close) {
                    geometry_msgs::msg::Point pt;
                    pt.x = x_global;
                    pt.y = y_global;
                    pt.z = 0.0;
                    mem.push_back(pt);
                }
            }
        }
    } else {
        // 정상 단계: 이미 drivelane 기준으로 분류되어 있음
        for (size_t lane_idx = 0; lane_idx < std::min(lane_clusters.size(), size_t(4)); ++lane_idx) {
            const auto& cluster = lane_clusters[lane_idx];
            if (cluster.empty()) continue;

            auto& mem = lane_point_memory_[lane_idx];
            for (const auto& p : cluster) {
                double x_global = vehicle_state.x + p.x * cos_yaw - p.y * sin_yaw;
                double y_global = vehicle_state.y + p.x * sin_yaw + p.y * cos_yaw;
                
                // 다운샘플링
                bool too_close = false;
                const double resolution_sq = MEMORY_DOWNSAMPLE_RESOLUTION * MEMORY_DOWNSAMPLE_RESOLUTION;
                for (const auto& existing : mem) {
                    double dx = x_global - existing.x;
                    double dy = y_global - existing.y;
                    if (dx * dx + dy * dy < resolution_sq) {
                        too_close = true;
                        break;
                    }
                }
                
                if (!too_close) {
                    geometry_msgs::msg::Point pt;
                    pt.x = x_global;
                    pt.y = y_global;
                    pt.z = 0.0;
                    mem.push_back(pt);
                }
            }
        }
    }
}

// array 버전 오버로드
void LaneProcessor::AddObservationsToMemory(
    const std::array<std::vector<Point2D>, 4>& lane_clusters,
    const std::vector<interface::PolyfitLane>& lanes,
    const interface::VehicleState& vehicle_state)
{
    if (lanes.empty()) return;

    double cos_yaw = std::cos(vehicle_state.yaw);
    double sin_yaw = std::sin(vehicle_state.yaw);

    // 정상 단계: 이미 drivelane 기준으로 분류되어 있음
    for (size_t lane_idx = 0; lane_idx < 4; ++lane_idx) {
        const auto& cluster = lane_clusters[lane_idx];
        if (cluster.empty()) continue;

        auto& mem = lane_point_memory_[lane_idx];
        for (const auto& p : cluster) {
            double x_global = vehicle_state.x + p.x * cos_yaw - p.y * sin_yaw;
            double y_global = vehicle_state.y + p.x * sin_yaw + p.y * cos_yaw;
            
            // 다운샘플링
            bool too_close = false;
            const double resolution_sq = MEMORY_DOWNSAMPLE_RESOLUTION * MEMORY_DOWNSAMPLE_RESOLUTION;
            for (const auto& existing : mem) {
                double dx = x_global - existing.x;
                double dy = y_global - existing.y;
                if (dx * dx + dy * dy < resolution_sq) {
                    too_close = true;
                    break;
                }
            }
            
            if (!too_close) {
                geometry_msgs::msg::Point pt;
                pt.x = x_global;
                pt.y = y_global;
                pt.z = 0.0;
                mem.push_back(pt);
            }
        }
    }
}

/**
 * ID: 18
 * description: 전역 좌표계의 포인트 목록을 차량 좌표계로 변환한다.
 *              회전 변환: x_veh = dx*cos(yaw) + dy*sin(yaw), y_veh = -dx*sin(yaw) + dy*cos(yaw)
 * input: global_points - 전역 좌표 포인트 목록 (std::vector<geometry_msgs::msg::Point>)
 *        vehicle_state - 현재 차량 상태 (interface::VehicleState)
 * output: 차량 좌표계 기준 포인트 목록 (std::vector<geometry_msgs::msg::Point>)
 */
std::vector<geometry_msgs::msg::Point> LaneProcessor::ConvertGlobalToVehicleFrame(
    const std::vector<geometry_msgs::msg::Point>& global_points,
    const interface::VehicleState& vehicle_state) const
{
    std::vector<geometry_msgs::msg::Point> result;
    result.reserve(global_points.size());
    
    double cos_yaw = std::cos(vehicle_state.yaw);
    double sin_yaw = std::sin(vehicle_state.yaw);
    
    for (const auto& p : global_points) {
        double dx = p.x - vehicle_state.x;
        double dy = p.y - vehicle_state.y;
        
        geometry_msgs::msg::Point veh_pt;
        veh_pt.x = dx * cos_yaw + dy * sin_yaw;
        veh_pt.y = -dx * sin_yaw + dy * cos_yaw;
        veh_pt.z = 0.0;
        result.push_back(veh_pt);
    }
    
    return result;
}

/**
 * ID: 19
 * description: 처리 상태를 1초 간격으로 로깅한다. 현재 driveway, 클러스터 수, 차선 수,
 *              각 차선 메모리 크기를 출력한다.
 * input: cluster_count - 클러스터 수 (size_t)
 *        lane_count - 차선 수 (size_t)
 * output: 없음 (로그 출력)
 */
void LaneProcessor::LogProcessingStatus(size_t cluster_count, size_t lane_count)
{
    static auto last_log = std::chrono::steady_clock::now();
    auto now = std::chrono::steady_clock::now();
    auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(now - last_log);
    
    if (elapsed.count() >= 1000) {
        last_log = now;
        
        std::string driveway_name;
        if (current_driveway_ == 1) driveway_name = "drivelane1 (lane1-lane2)";
        else if (current_driveway_ == 2) driveway_name = "drivelane2 (lane2-lane3)";
        else if (current_driveway_ == 3) driveway_name = "drivelane3 (lane3-lane4)";
        else driveway_name = "Unknown";
        
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "=== LANE PROCESSOR (frame %d) ===", total_processed_frames_);
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "Driveway: %s (conf: %.2f)", driveway_name.c_str(), driveway_confidence_);
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "Clusters: %zu, Lanes: %zu", cluster_count, lane_count);
        RCLCPP_INFO(rclcpp::get_logger("lane_processor"), 
            "Memory: lane1=%zu, lane2=%zu, lane3=%zu, lane4=%zu",
            lane_point_memory_[0].size(), lane_point_memory_[1].size(),
            lane_point_memory_[2].size(), lane_point_memory_[3].size());
    }
}

}  // namespace lane_processor
