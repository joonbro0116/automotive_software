<?xml version="1.0"?>
<launch>
    <arg name="ns1" default="ego"/>
    <arg name="loop_rate_hz" default="100.0"/>

    <node pkg="autonomous_driving" exec="lane_processor_node" name="lane_processor_node" namespace="$(var ns1)" output="screen">
        <param name="lane_processor/loop_rate_hz" value="$(var loop_rate_hz)"/>
    </node>
</launch>
